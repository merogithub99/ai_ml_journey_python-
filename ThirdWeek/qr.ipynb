   "source": [
    "import qrcode"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "fe26abc2",
   "metadata": {},
   "outputs": [],
   "source": [
    "data =input(\"Enter the text or url:\").strip()\n",
    "filename=input(\"Enter the filename\").strip()\n",
    "\n",
    "qr=qrcode.QRCode(\n",
    "  box_size=10,\n",
    "  border=4\n",
    ")\n",
    "qr.add_data(data)\n",
    "\n",
    "image=qr.make_image(fill_color='blue',back_color=\"white\")\n",
    "image.savve(filename)\n"
   ]
  }
